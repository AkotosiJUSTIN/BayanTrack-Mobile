<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/widget_surface"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="6dp"
        android:paddingTop="4dp"
        android:paddingEnd="6dp"
        android:paddingBottom="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@mipmap/bayantrack_logo" />

            <TextView
                android:id="@+id/widget_brand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:fontFamily="sans"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="BayanTrack"
                android:textColor="@color/widget_on_surface"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="18dp"
            android:layout_marginTop="2dp"
            android:fontFamily="sans"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="Emergency Report"
            android:textColor="@color/widget_on_surface"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_quick_report"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:layout_marginTop="3dp"
            android:background="@drawable/widget_location_info"
            android:fontFamily="sans"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="Choose incident"
            android:textColor="@color/widget_on_surface_secondary"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/widget_quick_report_submit"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:layout_marginTop="3dp"
            android:background="@drawable/widget_primary_action"
            android:fontFamily="sans"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:minHeight="28dp"
            android:text="Open"
            android:textColor="@color/widget_on_primary"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
